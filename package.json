{
  "name": "cheapclipper",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "turbo build",
    "dev": "bun --cwd=apps/web --env-file=../../.env run dev",
    "typecheck": "turbo typecheck",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down -v"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
