# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/cheapclipper

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=cheapclipper

# Enkripsi BYOK — 32 byte, base64. Buat dengan:
#   openssl rand -base64 32
BYOK_MASTER_KEY=

# Worker
WORKER_ID=local-1
WORKER_POLL_INTERVAL_SEC=2

# Transkripsi — dikonfigurasi sepenuhnya lewat env, tidak ada nama penyedia
# yang di-hardcode di source. Ganti penyedia = ubah berkas ini saja.
# Urutan menentukan rantai fallback: yang pertama dicoba lebih dulu.
#
# Catatan: Sumopod TIDAK menyediakan model audio (diperiksa 2026-07-27),
# jadi transkripsi tidak dapat disatukan ke sana. Sumopod tetap cocok untuk
# langkah LLM lewat BYOK. Lihat docs/adr/0001-transcription-provider.md.
TRANSCRIBE_PROVIDERS=deepinfra,groq

TRANSCRIBE_DEEPINFRA_URL=https://api.deepinfra.com/v1/openai/audio/transcriptions
TRANSCRIBE_DEEPINFRA_KEY=
TRANSCRIBE_DEEPINFRA_MODEL=openai/whisper-large-v3-turbo
TRANSCRIBE_DEEPINFRA_USD_PER_MIN=0.0002

TRANSCRIBE_GROQ_URL=https://api.groq.com/openai/v1/audio/transcriptions
TRANSCRIBE_GROQ_KEY=
TRANSCRIBE_GROQ_MODEL=whisper-large-v3-turbo
TRANSCRIBE_GROQ_USD_PER_MIN=0.0006

# Nama model yang dicatat di tabel transcripts. Dipakai sebagai kunci cache
# bersama source_id, jadi mengubahnya membuat seluruh transkrip lama meleset.
TRANSCRIBE_CACHE_MODEL=whisper-large-v3-turbo
