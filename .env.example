# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/klipmatic

# Supabase
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=klipmatic
R2_CORS_ORIGINS=http://localhost:3000

# Enkripsi BYOK — 32 byte, base64. Buat dengan:
#   openssl rand -base64 32
BYOK_MASTER_KEY=

# Worker
WORKER_ID=local-1
WORKER_POLL_INTERVAL_SEC=2

# Logging: pretty untuk terminal lokal, json untuk production/container ingestion.
LOG_LEVEL=INFO
LOG_FORMAT=pretty

# LLM analisis highlight — default operator sementara. Selama key ini terisi,
# worker memakai Nebius sebelum BYOK user. Hapus/kosongkan key untuk kembali
# ke key terenkripsi yang disimpan lewat halaman Settings.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Hybrid transcription. Untuk sumber YouTube, caption manual/otomatis dicoba
# sebelum audio diunduh. Caption yang terlalu pendek atau coverage-nya rendah
# otomatis jatuh ke DeepInfra/Groq.
YOUTUBE_CAPTION_FIRST=true
YOUTUBE_CAPTION_LANGS=id,id-ID
YOUTUBE_CAPTION_MIN_COVERAGE=0.35
YOUTUBE_CAPTION_MIN_WORDS=20

# Transkripsi — dikonfigurasi sepenuhnya lewat env, tidak ada nama penyedia
# yang di-hardcode di source. Ganti penyedia = ubah berkas ini saja.
# Urutan menentukan rantai fallback: yang pertama dicoba lebih dulu.
#
# Catatan: Sumopod TIDAK menyediakan model audio (diperiksa 2026-07-27),
# jadi transkripsi tidak dapat disatukan ke sana. Sumopod tetap cocok untuk
# langkah LLM lewat BYOK. Lihat docs/adr/0001-transcription-provider.md.
TRANSCRIBE_PROVIDERS=deepinfra,groq

TRANSCRIBE_DEEPINFRA_URL=https://api.deepinfra.com/v1/openai/audio/transcriptions
TRANSCRIBE_DEEPINFRA_KEY=
TRANSCRIBE_DEEPINFRA_MODEL=openai/whisper-large-v3-turbo
TRANSCRIBE_DEEPINFRA_USD_PER_MIN=0.0002

TRANSCRIBE_GROQ_URL=https://api.groq.com/openai/v1/audio/transcriptions
TRANSCRIBE_GROQ_KEY=
TRANSCRIBE_GROQ_MODEL=whisper-large-v3-turbo
TRANSCRIBE_GROQ_USD_PER_MIN=0.0006

# Nama model yang dicatat di tabel transcripts. Dipakai sebagai kunci cache
# bersama source_id, jadi mengubahnya membuat seluruh transkrip lama meleset.
TRANSCRIBE_CACHE_MODEL=whisper-large-v3-turbo

# Healthcheck kanari (spec §9.2). Kosongkan untuk memakai default di
# scripts/canary.py. Isi hanya bila sebuah URL kanari membusuk — mengganti
# lewat env lebih cepat daripada menunggu rilis.
CANARY_YOUTUBE_URL=
CANARY_TIKTOK_URL=
# Wajib diisi: berkas milik sendiri yang dibagikan publik. Tanpa ini Google
# Drive tidak terpantau sama sekali, dan skrip kanari keluar dengan kode 2
# supaya nightly merah — spec §9.2 mewajibkan ketiga platform dipantau.
CANARY_GDRIVE_URL=
