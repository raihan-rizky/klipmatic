FROM postgres:16-alpine
COPY migrations /migrations
RUN chmod -R a+rX /migrations
ENTRYPOINT ["/bin/sh", "-ec"]
CMD ["if [ \"$(psql -h postgres -U postgres -d klipmatic -tAc \"select to_regclass('public.jobs')\")\" != \"jobs\" ]; then psql -v ON_ERROR_STOP=1 -h postgres -U postgres -d klipmatic -f /migrations/0000_init.sql; fi; if [ \"$(psql -h postgres -U postgres -d klipmatic -tAc \"select to_regclass('public.media_assets')\")\" != \"media_assets\" ]; then psql -v ON_ERROR_STOP=1 -h postgres -U postgres -d klipmatic -f /migrations/0001_media_assets.sql; fi; if [ \"$(psql -h postgres -U postgres -d klipmatic -tAc \"select 1 from information_schema.columns where table_name = 'clip_candidates' and column_name = 'thumbnail_status'\")\" != \"1\" ]; then psql -v ON_ERROR_STOP=1 -h postgres -U postgres -d klipmatic -f /migrations/0002_candidate_previews.sql; fi; if [ \"$(psql -h postgres -U postgres -d klipmatic -tAc \"select 1 from information_schema.columns where table_name = 'clip_candidates' and column_name = 'preview_status'\")\" != \"1\" ]; then psql -v ON_ERROR_STOP=1 -h postgres -U postgres -d klipmatic -f /migrations/0003_candidate_preview_renders.sql; fi; if [ \"$(psql -h postgres -U postgres -d klipmatic -tAc \"select 1 from information_schema.columns where table_name = 'sources' and column_name = 'provider'\")\" != \"1\" ]; then psql -v ON_ERROR_STOP=1 -h postgres -U postgres -d klipmatic -f /migrations/0004_source_provenance.sql; fi; if [ \"$(psql -h postgres -U postgres -d klipmatic -tAc \"select 1 from information_schema.columns where table_name = 'media_segments' and column_name = 'is_fixture'\")\" != \"1\" ]; then psql -v ON_ERROR_STOP=1 -h postgres -U postgres -d klipmatic -f /migrations/0005_segment_provenance.sql; fi"]
